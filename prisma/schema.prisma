generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js v5 用のスキーマ
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  level         Int       @default(1)
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts          Account[]
  sessions          Session[]
  srsCards          SRSCard[]
  responses         Response[]
  badges            UserBadge[]
  settings          UserSettings?
  bookmarks         Bookmark[]
  dailySets         DailySet[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// アプリケーション固有のスキーマ
model Problem {
  id             String   @id @default(cuid())
  category       String
  level          Int
  difficulty     String
  promptJa       String   @map("prompt_ja") @db.Text
  promptEn       String?  @map("prompt_en") @db.Text
  starterCode    String   @map("starter_code") @db.Text
  expectedAnswer String   @map("expected_answer") @db.Text
  hints          String[]
  explanation    String   @db.Text
  tags           String[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  testCases TestCase[]
  srsCards  SRSCard[]
  responses Response[]
  bookmarks Bookmark[]

  @@index([category, level])
  @@map("problems")
}

model TestCase {
  id          String  @id @default(cuid())
  problemId   String  @map("problem_id")
  description String
  code        String  @db.Text
  shouldPass  Boolean @map("should_pass")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model SRSCard {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  problemId      String    @map("problem_id")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewDate DateTime  @map("next_review_date")
  lastReviewDate DateTime? @map("last_review_date")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, nextReviewDate])
  @@map("srs_cards")
}

model Response {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  problemId  String   @map("problem_id")
  quality    Int
  timeSpent  Int      @map("time_spent")
  wasCorrect Boolean  @map("was_correct")
  userAnswer String   @map("user_answer") @db.Text
  hintsUsed  Int      @default(0) @map("hints_used")
  /// 模範解答を表示して諦めた記録
  gaveUp     Boolean  @default(false) @map("gave_up")
  xpEarned   Int      @default(0) @map("xp_earned")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([problemId])
  @@map("responses")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model UserSettings {
  id                    String    @id @default(cuid())
  userId                String    @unique @map("user_id")
  dailyGoal             Int       @default(10) @map("daily_goal")
  reminderTime          String?   @map("reminder_time")
  reminderEnabled       Boolean   @default(true) @map("reminder_enabled")
  theme                 String    @default("dark")
  /// IANAタイムゾーン名。日付の区切り（今日・ストリーク・リマインダー）に使う
  timezone              String    @default("Asia/Tokyo")
  /// ランキングへの参加（任意参加のためデフォルトは不参加）
  rankingOptIn          Boolean   @default(false) @map("ranking_opt_in")
  lastReminderSentAt    DateTime? @map("last_reminder_sent_at")
  lastStreakAlertSentAt DateTime? @map("last_streak_alert_sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  problemId String   @map("problem_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@map("bookmarks")
}

/// その日のデイリーチャレンジの出題セット（1日の途中で出題が変わらないよう保存する）
model DailySet {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  /// ユーザーのタイムゾーンでの日付 "YYYY-MM-DD"
  date       String
  problemIds String[] @map("problem_ids")
  reviewIds  String[] @map("review_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_sets")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}
