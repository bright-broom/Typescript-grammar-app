# PostgreSQL（docker compose up -d で起動するローカルDB）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ts-grammar-dojo"

# Auth.js (NextAuth.js v5)
# 生成: npx auth secret もしくは openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# GitHub OAuth（https://github.com/settings/developers）
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth（https://console.cloud.google.com/apis/credentials）
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Web Push（リマインダー通知）。生成: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# /api/cron/reminders を呼ぶためのトークン（Authorization: Bearer <CRON_SECRET>）
CRON_SECRET=""
